{
  "name": "elibrary-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend tooling (build + lint) for eLibrary Manager. No runtime framework — vanilla ES modules served by FastAPI.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "lint": "eslint static/js",
    "lint:fix": "eslint static/js --fix",
    "format": "prettier --write static/js/**/*.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
