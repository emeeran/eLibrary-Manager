   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Portrait of athletic mature man after run. Handsome senior man resting after jog at the park on a sunny day. Sweaty multiethnic man listening to music while jogging.</rdf:li>
    </rdf:Alt>
