# Database
DATABASE_URL=sqlite+aiosqlite:///./dawnstar_data/dawnstar.db

# Library
LIBRARY_PATH=./library
COVERS_PATH=./static_covers

# AI Providers (in priority order)
# Google Gemini (Primary) - Get key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_key_here
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_RATE_LIMIT_RPM=15

# Groq (Secondary) - Get key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RATE_LIMIT_RPM=30

# Ollama Local (Fallback - works offline)
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=llama3.3

# AI Settings
AI_DEFAULT_PROVIDER=auto
AI_ENABLE_FALLBACK=true

# Login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# Required: Strong secret key for crypto operations
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Performance
MAX_COVER_SIZE=300000
LAZY_LOAD_BATCH_SIZE=20
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
