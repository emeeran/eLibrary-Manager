# Database
DATABASE_URL=sqlite+aiosqlite:///./dawnstar_data/dawnstar.db

# Library
LIBRARY_PATH=./library
COVERS_PATH=./static_covers
BOOK_IMAGES_PATH=./static_book_images

# AI Providers (in priority order: Google -> Ollama Cloud -> Ollama Local)
# Google Gemini (Primary) - Get key from https://aistudio.google.com/apikey
# Note: GEMINI_API_KEY (read from the environment) takes priority over GOOGLE_API_KEY
GOOGLE_API_KEY=your_google_key_here
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_RATE_LIMIT_RPM=15

# Ollama Cloud (Secondary)
OLLAMA_CLOUD_URL=https://api.ollama.ai
OLLAMA_CLOUD_MODEL=llama3.3

# Ollama Local (Fallback - works offline)
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=llama3.2:3b

# AI Settings
AI_DEFAULT_PROVIDER=auto
AI_ENABLE_FALLBACK=true
AI_REQUEST_TIMEOUT=30.0
AI_MAX_RETRIES=2

# Login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
# Or provide a bcrypt hash instead of plaintext (preferred):
# ADMIN_PASSWORD_HASH=

# Required in production (APP_ENV=production): strong secret key for crypto operations
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# NAS (optional - serve a pre-mounted SMB/NFS share)
NAS_ENABLED=false
NAS_HOST=
NAS_MOUNT_PATH=
NAS_CACHE_DIR=./nas_cache

# Performance
MAX_COVER_SIZE=300000
MAX_UPLOAD_SIZE_MB=100
LAZY_LOAD_BATCH_SIZE=20
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
